          {
            "type": "calculated",
            "name": "Season",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              " SWITCH(TRUE(),",
              "DimDate[QuarterNumber] = 1, \"Winter\",",
              "DimDate[QuarterNumber] = 2, \"Spring\",",
              "DimDate[QuarterNumber] = 3, \"Summer\",",
              "DimDate[QuarterNumber] = 4, \"Fall\")"
            ],
            "sortByColumn": "QuarterNumber"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
