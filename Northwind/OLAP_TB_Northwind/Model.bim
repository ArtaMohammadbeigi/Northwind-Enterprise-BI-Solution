        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"SQL/ARTA;NorthwindDW\",",
                "    dbo_FactOrders = Source{[Schema=\"dbo\",Item=\"FactOrders\"]}[Data]",
                "in",
                "    dbo_FactOrders"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Distinct Count of OrderID",
            "expression": "DISTINCTCOUNT([OrderID])",
            "formatString": "#,#",
            "displayFolder": "Orders"
          },
          {
            "name": "Total Sales",
            "expression": [
              "",
              "SUMX(",
              "    FactOrders,",
              "    FactOrders[Quantity] * FactOrders[UnitPrice] * (1 - FactOrders[Discount])",
              ")"
            ],
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "displayFolder": "Orders",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\" Accuracy=\"2\"><Currency LCID=\"1033\" DisplayName=\"$ English (United States)\" Symbol=\"$\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "Avg Order Value",
            "expression": [
              "",
              "DIVIDE([Total Sales], [Distinct Count of OrderID])"
            ],
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "displayFolder": "Orders",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\" Accuracy=\"2\"><Currency LCID=\"1033\" DisplayName=\"$ English (United States)\" Symbol=\"$\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "Total Discount",
            "expression": [
              "",
              "SUMX(",
              "    FactOrders,",
              "    FactOrders[Quantity] * FactOrders[UnitPrice] * (FactOrders[Discount])",
              ")"
            ],
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "displayFolder": "Orders",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\" Accuracy=\"2\"><Currency LCID=\"1033\" DisplayName=\"$ English (United States)\" Symbol=\"$\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "Total Sales Amount",
            "expression": [
              "",
              "SUMX(",
              "    FactOrders,",
              "    FactOrders[Quantity] * FactOrders[UnitPrice] ",
              ")"
            ],
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "displayFolder": "Orders",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\" Accuracy=\"2\"><Currency LCID=\"1033\" DisplayName=\"$ English (United States)\" Symbol=\"$\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "Avg Shipping Days",
            "expression": [
              "",
              "AVERAGEX(",
              "    FactOrders,",
              "    DATEDIFF(FactOrders[OrderDate], FactOrders[ShippedDate], DAY)",
              ")",
              ""
            ],
            "displayFolder": "Orders"
          },
          {
            "name": "Avg Discount",
            "expression": [
              "",
              "AVERAGEX(",
              "    FactOrders,",
              "    FactOrders[Quantity] * FactOrders[UnitPrice] * (FactOrders[Discount])",
              ")"
            ],
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "displayFolder": "Orders",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\" Accuracy=\"2\"><Currency LCID=\"1033\" DisplayName=\"$ English (United States)\" Symbol=\"$\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "Total Units Sold",
            "expression": [
              "",
              "SUM(FactOrders[Quantity])"
            ],
            "formatString": "#,#",
            "displayFolder": "Orders"
          },
          {
            "name": "Total Orders",
            "expression": " DISTINCTCOUNT(FactOrders[OrderID])",
            "displayFolder": "Orders"
          },
          {
            "name": "Sales LY",
            "expression": [
              " ",
              "CALCULATE(",
              "    [Total Sales Amount],",
              "    SAMEPERIODLASTYEAR('DimDate'[FullDate])",
              ")"
            ],
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "displayFolder": "Orders",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\" Accuracy=\"2\"><Currency LCID=\"1033\" DisplayName=\"$ English (United States)\" Symbol=\"$\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "YoY Sales Variance",
            "expression": " [Total Sales Amount] - [Sales LY]",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "displayFolder": "Orders",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\" Accuracy=\"2\"><Currency LCID=\"1033\" DisplayName=\"$ English (United States)\" Symbol=\"$\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "YoY Sales %",
            "expression": [
              " ",
              "DIVIDE(",
              "    [YoY Sales Variance],",
              "    [Sales LY],",
              "    0",
              ")"
            ],
            "formatString": "0.00%;-0.00%;0.00%",
            "displayFolder": "Orders",
            "kpi": {
              "targetExpression": "0",
              "targetFormatString": "0.00%;-0.00%;0.00%",
              "statusGraphic": "Traffic Light - Single",
              "statusExpression": [
                "var x='FactOrders'[YoY Sales %] return",
                "            if(ISBLANK(x),BLANK(),",
                "                    If(x<-0.05,-1,",
                "\t                If(x<0.05,0,1)",
                "                )",
                "            )",
                "            "
              ],
              "annotations": [
                {
                  "name": "GoalType",
                  "value": "StaticValue"
                },
                {
                  "name": "KpiStatusType",
                  "value": "Linear"
                },
                {
                  "name": "KpiThresholdType",
                  "value": "Absolute"
                },
                {
                  "name": "KpiThresholdOrdering",
                  "value": "Ascending"
                },
                {
                  "name": "KpiThresholdCount",
                  "value": "2"
                },
                {
                  "name": "KpiThreshold_0",
                  "value": "-0.05"
                },
                {
                  "name": "KpiThreshold_1",
                  "value": "0.05"
                }
              ]
            }
          }
        ]
      }
    ],
