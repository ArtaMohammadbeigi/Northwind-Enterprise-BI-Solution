    "tables": [
      {
        "name": "DimCustomers",
        "columns": [
          {
            "name": "CustomerKey",
            "dataType": "int64",
            "sourceColumn": "CustomerKey"
          },
          {
            "name": "GeographyKey",
            "dataType": "int64",
            "sourceColumn": "GeographyKey"
          },
          {
            "name": "CompanyName",
            "dataType": "string",
            "sourceColumn": "CompanyName"
          },
          {
            "name": "ContactName",
            "dataType": "string",
            "sourceColumn": "ContactName"
          },
          {
            "name": "ContactTitle",
            "dataType": "string",
            "sourceColumn": "ContactTitle"
          },
          {
            "name": "Startdate",
            "dataType": "dateTime",
            "sourceColumn": "Startdate"
          },
          {
            "name": "Enddate",
            "dataType": "dateTime",
            "sourceColumn": "Enddate"
          },
          {
            "type": "calculated",
            "name": "Tier_Number",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "expression": [
              "",
              "VAR TotalOrders =",
              "    CALCULATE(DISTINCTCOUNT(FactOrders[OrderID]))",
              "",
              "VAR Q1 =",
              "    PERCENTILEX.INC(",
              "        ALL(DimCustomers),",
              "        CALCULATE(DISTINCTCOUNT(FactOrders[OrderID])),",
              "        0.25",
              "    )",
              "",
              "VAR Q2 =",
              "    PERCENTILEX.INC(",
              "        ALL(DimCustomers),",
              "        CALCULATE(DISTINCTCOUNT(FactOrders[OrderID])),",
              "        0.50",
              "    )",
              "",
              "VAR Q3 =",
              "    PERCENTILEX.INC(",
              "        ALL(DimCustomers),",
              "        CALCULATE(DISTINCTCOUNT(FactOrders[OrderID])),",
              "        0.75",
              "    )",
              "",
              "RETURN",
              "SWITCH(",
              "    TRUE(),",
              "    TotalOrders >= Q3, 4,",
              "    TotalOrders >= Q2, 3,",
              "    TotalOrders >= Q1, 2,",
              "    1",
              ")"
            ]
          },
          {
            "type": "calculated",
            "name": "Customer_Tier",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "",
              "SWITCH(",
              "    [Tier_Number],",
              "    4, \"Royal\",",
              "    3, \"Gold\",",
              "    2, \"Silver\",",
              "    1, \"Bronze\"",
              ")"
            ],
            "sortByColumn": "Tier_Number"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"SQL/ARTA;NorthwindDW\",",
                "    dbo_DimCustomers = Source{[Schema=\"dbo\",Item=\"DimCustomers\"]}[Data],",
                "    #\"Removed Columns\" = Table.RemoveColumns(dbo_DimCustomers,{\"CustomerAlternateKey\", \"Phone\", \"Fax\"})",
                "in",
                "    #\"Removed Columns\""
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Total Customers",
            "expression": " DISTINCTCOUNT(DimCustomers[CustomerKey])",
            "displayFolder": "Customers"
          },
          {
            "name": "Avg Revenue per Customer",
            "expression": [
              "",
              "DIVIDE([Total Sales], [Total Customers])"
            ],
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "displayFolder": "Customers",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\" Accuracy=\"2\"><Currency LCID=\"1033\" DisplayName=\"$ English (United States)\" Symbol=\"$\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          }
        ]
      },
