            "dataType": "dateTime",
            "sourceColumn": "HireDate"
          },
          {
            "name": "Startdate",
            "dataType": "dateTime",
            "sourceColumn": "Startdate"
          },
          {
            "name": "Enddate",
            "dataType": "dateTime",
            "sourceColumn": "Enddate"
          },
          {
            "type": "calculated",
            "name": "FullName",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": " DimEmployees[FirstName] & \" \" & DimEmployees[LastName]"
          },
          {
            "type": "calculated",
            "name": "Age",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "expression": " DATEDIFF(DimEmployees[BirthDate], TODAY(),YEAR)"
          },
          {
            "type": "calculated",
            "name": "EmployeePath",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": "PATH(DimEmployees[EmployeeKey],DimEmployees[ReportsToKey])"
          },
          {
            "type": "calculated",
            "name": "LenPath",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "expression": "PATHLENGTH(DimEmployees[EmployeePath])"
          },
          {
            "type": "calculated",
            "name": "Level1",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "",
              "LOOKUPVALUE(",
              "    DimEmployees[FullName],",
              "    DimEmployees[EmployeeKey],",
              "    PATHITEM(DimEmployees[EmployeePath], 1, INTEGER) ",
              ")"
            ]
          },
          {
            "type": "calculated",
            "name": "Level2",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "",
              "LOOKUPVALUE(",
              "    DimEmployees[FullName],",
              "    DimEmployees[EmployeeKey],",
              "    PATHITEM(DimEmployees[EmployeePath], 2, INTEGER)",
              ")"
            ]
          },
          {
            "type": "calculated",
            "name": "Level3",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "",
              "LOOKUPVALUE(",
              "    DimEmployees[FullName],",
              "    DimEmployees[EmployeeKey],",
              "    PATHITEM(DimEmployees[EmployeePath], 3, INTEGER)",
              ")"
            ]
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"SQL/ARTA;NorthwindDW\",",
                "    dbo_DimEmployees = Source{[Schema=\"dbo\",Item=\"DimEmployees\"]}[Data],",
                "    #\"Removed Columns\" = Table.RemoveColumns(dbo_DimEmployees,{\"EmployeeAlternateKey\", \"HomePhone\", \"Extension\", \"Photo\", \"Notes\", \"ReportsTo\", \"PhotoPath\"})",
                "in",
                "    #\"Removed Columns\""
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Avg Work Experience",
            "expression": [
              "",
              "AVERAGEX(",
              "    DimEmployees,",
              "    DATEDIFF(",
              "        DimEmployees[HireDate],",
              "        COALESCE(DimEmployees[EndDate], TODAY()),",
              "        YEAR",
              "    )",
              ")"
            ],
            "displayFolder": "Employees"
          },
          {
            "name": "Avg Age",
            "expression": " AVERAGE(DimEmployees[Age])",
            "displayFolder": "Employees"
          },
          {
            "name": "Total Employees",
            "expression": [
              "",
              "DISTINCTCOUNT(DimEmployees[EmployeeKey])"
            ],
            "displayFolder": "Employees"
          }
        ],
        "hierarchies": [
          {
            "name": "EmployeeHierarchy",
            "hideMembers": "hideBlankMembers",
            "levels": [
              {
                "name": "Level_1",
                "ordinal": 0,
                "column": "Level1"
              },
              {
                "name": "Level_2",
                "ordinal": 1,
                "column": "Level2"
              },
              {
                "name": "Level_3",
                "ordinal": 2,
                "column": "Level3"
              }
            ]
          }
        ]
      },
