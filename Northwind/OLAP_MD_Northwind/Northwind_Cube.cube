  <MdxScripts>
    <MdxScript dwd:design-time-name="e4b948c9-fb1f-41ed-94b5-8c3e26edec65">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
The CALCULATE command controls the aggregation of leaf cells in the cube.
If the CALCULATE command is deleted or modified, the data within the cube is affected.
You should edit this command only if you manually specify how the cube is aggregated.
*/
CALCULATE;

CREATE MEMBER CURRENTCUBE.[Measures].[Gross Sales]
AS
SUM(
    EXISTING [DimOrders].[Order ID].[Order ID].Members,
    [Measures].[Unit Price] * [Measures].[Quantity]
),
FORMAT_STRING = "#,##0.00",
VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Discount Amount]
AS
SUM(
    EXISTING [DimOrders].[Order ID].[Order ID].Members,
    [Measures].[Unit Price] * [Measures].[Quantity] * [Measures].[Discount]
),
FORMAT_STRING = "#,##0.00",
VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Net Sales]
AS
[Measures].[Gross Sales] - [Measures].[Discount Amount],
FORMAT_STRING = "#,##0.00",
VISIBLE = 1; </Text>
        </Command>
      </Commands>
      <CalculationProperties>
        <CalculationProperty dwd:design-time-name="a958ad34-cf63-4c5f-b7df-db1ae838b298">
          <CalculationReference>[Measures].[Gross Sales]</CalculationReference>
          <CalculationType>Member</CalculationType>
          <Translations>
            <Translation dwd:design-time-name="6ec37e4e-3dd7-4fd9-b18f-34ed4361604a">
              <Language>1065</Language>
              <Caption>فروش ناخالص</Caption>
            </Translation>
          </Translations>
        </CalculationProperty>
        <CalculationProperty dwd:design-time-name="0bdabc1b-b3b1-4c04-b758-f08310d2fae6">
          <CalculationReference>[Measures].[Discount Amount]</CalculationReference>
          <CalculationType>Member</CalculationType>
          <Translations>
            <Translation dwd:design-time-name="2d5f4dae-f5b6-4aac-8b4a-7fc330fa25b3">
              <Language>1065</Language>
              <Caption>مبلغ تخفیف</Caption>
            </Translation>
          </Translations>
        </CalculationProperty>
        <CalculationProperty dwd:design-time-name="00479801-f1c9-4c0d-80ed-48eb268e06b3">
          <CalculationReference>[Measures].[Net Sales]</CalculationReference>
          <CalculationType>Member</CalculationType>
          <Translations>
            <Translation dwd:design-time-name="4a809248-5057-447f-b826-0d2bd66a1526">
              <Language>1065</Language>
              <Caption>فروش خالص</Caption>
            </Translation>
          </Translations>
        </CalculationProperty>
      </CalculationProperties>
    </MdxScript>
  </MdxScripts>
